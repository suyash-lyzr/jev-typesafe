# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Lyzr's TypeSafe key. Server-side only — it must never reach the browser.
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Compare (optional; the Compare tab hides itself without it)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
# Confirm the id and both prices against OpenAI's pricing page before launch.
OPENAI_COMPARE_MODEL=gpt-5.4-mini
OPENAI_IN_PER_M=0.75
OPENAI_OUT_PER_M=4.50

# ---------------------------------------------------------------------------
# Counters (optional locally, REQUIRED in production)
# ---------------------------------------------------------------------------
# Without these the app runs but spends fail closed: live runs are refused
# because nothing can observe the day's spend. Upstash free tier is fine.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing caller IPs. Any long random string; raw IPs are never stored.
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Budgets and quotas (optional — these are the defaults)
# ---------------------------------------------------------------------------

DAILY_JEV_BUDGET_USD=10
DAILY_OPENAI_BUDGET_USD=15

PLAY_MIN=30
PLAY_DAY=300
COMPARE_MIN=10
COMPARE_DAY=20

GLOBAL_JEV_MIN=600
GLOBAL_JEV_DAY=20000
GLOBAL_COMPARE_MIN=60
GLOBAL_COMPARE_DAY=1500

# Set to 1 to pause every live run; presets fall back to recorded replays.
JEVLAB_KILL_SWITCH=0

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Printed next to latency so it is never read as TypeSafe's compute time.
NEXT_PUBLIC_SITE_REGION=iad1
