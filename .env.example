# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Lyzr's TypeSafe key. Server-side only — it must never reach the browser.
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Compare (optional; without a key, comparisons run the Jev half and say why)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
# The defaults are TypeSafe's own cookbook assumption for gpt-5.4-mini, not a
# checked price. Confirm the id and both prices on OpenAI's pricing page, then
# set OPENAI_PRICE_CONFIRMED_ON to that date (YYYY-MM-DD); until then the site
# labels the price "assumed".
# Default comparison model; visitors can pick any model listed in lib/llm-models.ts.
OPENAI_COMPARE_MODEL=gpt-5.6-terra
OPENAI_IN_PER_M=0.75
OPENAI_OUT_PER_M=4.50
OPENAI_PRICE_CONFIRMED_ON=
# The model's fastest reasoning setting. Unset picks "minimal" for gpt-5 and
# "none" for later generations; "off" sends no parameter at all.
OPENAI_REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Counters (optional locally, REQUIRED in production)
# ---------------------------------------------------------------------------
# Without these the app runs but spends fail closed: live runs are refused
# because nothing can observe the day's spend. Upstash free tier is fine.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing caller IPs. Any long random string; raw IPs are never stored.
# If unset, one is derived from TYPESAFE_API_KEY (secret, but set this anyway).
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Budgets and quotas (optional — these are the defaults)
# ---------------------------------------------------------------------------

DAILY_JEV_BUDGET_USD=10
DAILY_OPENAI_BUDGET_USD=15

PLAY_MIN=30
PLAY_DAY=300
COMPARE_MIN=10
COMPARE_DAY=5
# Owner pass: visit /api/owner?token=<value> to skip the daily comparison quota in that browser.
COMPARE_OWNER_TOKEN=

GLOBAL_JEV_MIN=600
GLOBAL_JEV_DAY=20000
GLOBAL_COMPARE_MIN=60
GLOBAL_COMPARE_DAY=1500

# Set to 1 to pause every live run; an unedited preset shows its recording instead.
JEVLAB_KILL_SWITCH=0

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra origins allowed to call the API (comma-separated), e.g. a custom domain
# in front of *.vercel.app.
ALLOWED_ORIGINS=
# Who may show the site in an iframe (space-separated origins). Unset: nobody.
# e.g. FRAME_ANCESTORS=https://architect.new
FRAME_ANCESTORS=
# Where "Report drift" links on /limits go (a GitHub issues URL). Unset hides them.
NEXT_PUBLIC_ISSUES_URL=
# Printed next to latency so it is never read as TypeSafe's compute time.
NEXT_PUBLIC_SITE_REGION=iad1
